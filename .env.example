NODE_ENV=development
PORT=3000

# PostgreSQL (Bun.sql)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hono_app

# Redis (Bun.redis)
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
# detik (3600 = 1 jam)
JWT_EXPIRES_IN=3600

# Dipakai docker-compose
POSTGRES_USER=your-user-postgres
POSTGRES_PASSWORD=your-passwod-postgres
POSTGRES_DB=your-db-pg
POSTGRES_PORT=5432
REDIS_PORT=6379
